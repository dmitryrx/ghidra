<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Qpasa Reverb</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
    </choices-outline>
    <choice id="vst3" title="VST3" description="Для Ableton, FL Studio, Cubase, Reaper и других.">
        <pkg-ref id="com.qpasaaudio.qpasareverb.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit (AU)" description="Для Logic Pro, GarageBand и других.">
        <pkg-ref id="com.qpasaaudio.qpasareverb.au"/>
    </choice>
    <pkg-ref id="com.qpasaaudio.qpasareverb.vst3">vst3.pkg</pkg-ref>
    <pkg-ref id="com.qpasaaudio.qpasareverb.au">au.pkg</pkg-ref>
</installer-gui-script>
